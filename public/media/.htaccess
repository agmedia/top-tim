# Uploaded media are data; never run server-side scripts from this tree.
Options -ExecCGI -Indexes
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .cgi .pl .py .sh .shtml
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .cgi .pl .py .sh .shtml

<FilesMatch "(?i)(?:^\.|\.(?:php[0-9]*|phtml?|pht|phar|cgi|pl|py|sh|shtml)(?:\.|$))">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
